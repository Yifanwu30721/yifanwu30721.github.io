{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"]},"docs":[{"location":"","title":"\u6b22\u8fce\u6765\u5230\u9492\u9492\u7684\u8d5b\u535a\u5c0f\u5c4b\uff5e","text":"<p>\u672c\u7ad9\u4ecd\u5728\u5efa\u8bbe\u5e76\u6301\u7eed\u66f4\u65b0\u4e2d\uff0c\u5982\u6709\u4fe1\u606f\u7f3a\u5931\uff0c\u656c\u8bf7\u8c05\u89e3\u5e76\u6307\u6b63\u3002</p>"},{"location":"#_2","title":"\u9492\u9492\u662f\u8c01","text":"<ul> <li>\u6d59\u6c5f\u5927\u5b66-\u7afa\u53ef\u6862\u5b66\u9662\uff08\u667a\u80fd\u8d22\u52a1\u73ed\uff092021\u7ea7\u672c\u79d1\u6bd5\u4e1a\u751f</li> <li>\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66-\u7406\u5b66\u9662\uff08\u91cf\u5316\u91d1\u878d\uff092026\u7ea7\u7855\u58eb\u65b0\u751f</li> <li>\u798f\u5efa\u4eba\uff0c\u6d59\u6c5f\u5927\u5b66\u798f\u5efa\u793e\u7fa4\u524d\u7fa4\u4e3b\uff0c\u4e24\u5c4a\u6d59\u5927\u798f\u5efa\u62db\u751f\u7ec4\u6210\u5458</li> <li> <p>\u94a2\u7434\u4e0e\u5373\u5174\u7f16\u66f2\u7231\u597d\u8005\uff0c\u53c2\u8bad\u5e72\u90e8\uff08\u66fe\u4efb\uff09\uff0c\u7814\u7a76\u52a9\u7406\uff08\u66fe\u4efb\uff09\uff0c\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66\u4ea4\u6362\u751f\uff082023\u5e74\uff09\uff0c\u4e09\u83f1\u7ffc\u795e\u8f66\u4e3b\uff0c\u80a1\u5e02\u8001\u6cb9\u6761\uff0c\u5e01\u5708\u7eaf\u65b0\u624b\u2026\u2026</p> </li> <li> <p>\u7535\u5b50\u90ae\u7bb1\uff1aYifanwu30721@gmail.com</p> </li> </ul>"},{"location":"%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/","title":"\u5065\u8eab\u8bb0\u5f55","text":"<ul> <li> <p>2025\u5e747\u670826\u65e5 \u4f53\u91cd87.1\u516c\u65a4\uff08\u9910\u524d\uff09\uff0c\u592a\u80d6\u5566\uff01</p> </li> <li> <p>2025\u5e748\u670812\u65e5 \u4f53\u91cd\u964d\u5230\u4e8681.5\u516c\u65a4\uff08\u9910\u524d\uff09\uff0c\u5176\u5b9e\u6700\u8fd1\u5065\u8eab\u7684\u91cf\u4e5f\u4e0d\u591a\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u98df\u91cf\u51cf\u5c11\uff0c\u7126\u8651\u589e\u591a\u800c\u5bfc\u81f4\u7684\u3002</p> </li> </ul>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%90%83%E5%9C%A8%E5%9D%A1%E5%B2%9B/","title":"\u5403\u5728\u5761\u5c9b","text":""},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%AD%A6%E5%9C%A8%E5%9D%A1%E5%B2%9B/","title":"\u5b66\u5728\u5761\u5c9b","text":""},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E8%BD%AE%E4%B8%8A%E5%9D%A1%E5%B2%9B/","title":"\u8f6e\u4e0a\u5761\u5c9b","text":""},{"location":"%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/","title":"\u9492\u9492\u7684\u60c5\u611f\u65e5\u8bb0","text":"<ul> <li>2025\u5e748\u670812\u65e5 \u8fd9\u4e9b\u5929\u5728\u65b0\u52a0\u5761\uff0c\u5176\u5b9e\u9047\u5230\u4e86\u5f88\u591a\u4e0d\u987a\u5fc3\u7684\u4e8b\u60c5\uff1a\u9009\u8bfe\u53d7\u963b\uff1b\u5b66\u751f\u7b7e\uff08STP\uff09\u8fdf\u8fdf\u4e0d\u4e0b\uff1b\u975e\u5e38\u5f3a\u70c8\u7684\u601d\u5bb6\u60c5\u7eea\u2026\u2026\u5176\u5b9e\u65b0\u52a0\u5761\u79bb\u5bb6\u5e76\u4e0d\u8fdc\uff08\u751a\u81f3\u8fd8\u7565\u8fd1\u4e8e\u6211\u56fd\u7684\u65b0\u7586\uff09\uff0c\u6211\u4e4b\u524d\u4e5f\u5728\u6b64\u4ea4\u6362\u8fc7\u5c0f\u534a\u5e74\uff0c\u4f46\u8fd9\u6b21\u590d\u6742\u7684\u60c5\u7eea\u7ed9\u6211\u5e26\u6765\u4e86\u8bf8\u591a\u714e\u71ac\uff1a\u6bcf\u5929\u65e9\u4e0a\u9192\u6765\uff0c\u5c31\u9677\u5165\u5f3a\u70c8\u7684\u7126\u8651\u548c\u60f3\u5bb6\u4e4b\u4e2d\uff1b\u4f46\u6bcf\u5929\u665a\u4e0a\uff0c\u505a\u5b8c\u6bcf\u65e5\u7684\u7410\u4e8b\uff0c\u9759\u9759\u5446\u5728\u623f\u95f4\u91cc\u7684\u65f6\u5019\uff0c\u5374\u53c8\u89c9\u5f97\u73b0\u5728\u7684\u81ea\u5df1\u662f\u4f55\u7b49\u5e78\u8fd0\u3002 \u6211\u7684\u540c\u5b66\u90fd\u662f\u5f88\u4f18\u79c0\u7684\u4eba\uff0c\u548c\u6211\u4e00\u6837\uff0c\u6bd5\u4e1a\u4e8eZJU\u6216\u8005\u5176\u4ed6\u66f4\u597d\u7684\u540d\u6821\uff0c\u6709\u4e00\u4e9b\u5728\u4f20\u7edf\u91d1\u878d/\u91cf\u5316\u5b9e\u76d8\u65b9\u9762\u5df2\u7ecf\u5c0f\u6709\u6210\u5c31\uff0c\u548c\u4ed6\u4eec\u5728\u4e00\u8d77\u786e\u5b9e\u8ba9\u6211\u7684\u773c\u754c\u6709\u4e86\u8d28\u7684\u63d0\u5347\u3002\u65b0\u52a0\u5761\u5176\u5b9e\u4e5f\u662f\u4e00\u4e2a\u5f88\u597d\u7684\u56fd\u5bb6\uff0c\u81f3\u5c11\u6765\u8bf4\uff0c\u5e72\u51c0\u3001\u4e25\u8c28\u3001\u9ad8\u7d20\u8d28\u3002NUS\u7684\u5b66\u98ce\u4e5f\u76f8\u5bf9\u7075\u6d3b\u3001\u81ea\u7531\u4e00\u4e9b\uff08\u5982\u679c\u771f\u7684\u6709\u4e8b\uff0c\u6ca1\u6cd5\u6765\u542c\u8bfe\uff0c\u53ef\u4ee5\u6362\u65f6\u95f4\u6bb5\u6216\u8005\u770b\u56de\u653e\uff09\u2026\u2026\u5bf9\u4e8e\u8fd9\u4e9b\uff0c\u6211\u4e0d\u5426\u8ba4\uff0c\u4e14\u5f3a\u70c8\u80af\u5b9a\uff0c\u8fd9\u4e5f\u662f\u6211\u665a\u4e0a\u8ba4\u4e3a\u201c\u6211\u5f88\u5e78\u798f\u201d\u7684\u91cd\u8981\u539f\u56e0\uff1b \u4f46\u662f\uff0c\u60f3\u5bb6\uff0c\u5f88\u5f3a\u70c8\u7684\u60f3\u5bb6\uff0c\u5728\u67d0\u4e9b\u65f6\u523b\uff0c\u65b0\u52a0\u5761\u7684\u4e00\u5207\u4f18\u70b9\uff0c\u90fd\u80fd\u88ab\u8fd9\u4e2a\u8bcd\u4e00\u4e3e\u51fb\u788e\uff0c\u8fd9\u662f\u6211\u5728\u56fd\u5185\u4efb\u4f55\u5730\u65b9\u90fd\u65e0\u6cd5\u611f\u53d7\u5230\u7684\u3002\uff08\u540e\u7eed\u518d\u5199\u5427\uff0c\u60c5\u611f\u7206\u53d1\u4e86\uff0c\u60f3\u4f11\u606f\u4e00\u4f1a\uff09</li> </ul>"},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/","title":"\u6211\u4e0e\u7ffc\u795e","text":""},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/#_2","title":"\u4e3a\u4ec0\u4e48\u4e70\u7ffc\u795e","text":"<p>2024\u5e7412\u6708\uff0c\u548c\u670b\u53cb\u4e00\u8d77\u53bb\u901b\u4e8c\u624b\u8f66\u5e02\u573a\uff0c\u672c\u6765\u60f3\u8981\u770b\u4e00\u8f86\u4fbf\u5b9c\u7684\u798f\u7279\u5609\u5e74\u534e\uff0c\u4f46\u540e\u6765\u53d1\u73b0\u7f51\u4e0a\u7684\u4ef7\u683c\u7eaf\u5f15\u6d41\uff0c\u5b9e\u9645\u4ef7\u683c\u8d35\u5f97\u591a\u3002\u4e34\u8d70\u65f6\uff0c\u6b63\u5de7\u770b\u5230\u4e86\u8fd9\u8f86\u4fdd\u517b\u7684\u5f88\u597d\u7684\u4e09\u83f1\u7ffc\u795e\uff0c\u4ef7\u683c\u4e5f\u5408\u9002\uff0c\u9042\u679c\u65ad\u4e70\u4e0b\uff08\u8be6\u60c5\u8bf7\u770bcc98: https://www.cc98.org/topic/6062784\uff0c\u9700\u6d59\u5927VPN\u767b\u5f55\uff09</p>"},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/#_3","title":"\u6211\u548c\u7ffc\u795e\u7684\u6545\u4e8b","text":"<p>\u81f3\u4eca\uff082025\u5e747\u6708\uff09\uff0c\u6211\u5df2\u7ecf\u5f00\u7740\u5b83\u8d70\u8fc7\u4e864000\u4f59\u516c\u91cc\uff0c\u5728\u676d\u5dde\u5e02\u5185\u7ecf\u5386\u4e86\u7d2b\u91d1\u6e2f-\u7389\u6cc9\u7684\u65e0\u6570\u6b21\u901a\u52e4\uff0c\u6d59\u5927\u7684\u4e03\u4e2a\u6821\u533a\uff0c\u9664\u4e86\u4e4b\u6c5f\u6821\u533a\u5916\uff0c\u6211\u90fd\u5f00\u7740\u5b83\u53bb\u8fc7\u3002\u5728\u676d\u5dde\u5e02\u5916\uff0c\u6211\u4eec\u53bb\u4e86\u6d77\u5b81\u3001\u821f\u5c71\uff0c\u4ee5\u53ca\u6bd5\u4e1a\u540e\u5343\u91cc\u8fe2\u8fe2\u5954\u56de\u798f\u5efa\u3002\u5b83\u603b\u662f\u6709\u4e00\u4e9b\u5c0f\u6bdb\u75c5\uff0c\u6bd4\u5982\u8f66\u7a97\u964d\u4e0d\u4e0b\u6765\uff0c\u5929\u7a97\u6f0f\u6c34\u7b49\u7b49\uff0c\u4f46\u6211\u6b23\u6170\u7684\u662f\uff0c\u5b83\u4ece\u6ca1\u6709\u628a\u6211\u6482\u5728\u8def\u4e0a\uff0c\u5f88\u5fe0\u5b9e\uff0c\u5f88\u53ef\u9760\u3002 \u73b0\u5728\uff0c\u5b83\u9759\u9759\u8eba\u5728\u6211\u5bb6\u5c0f\u533a\u7684\u4e00\u9685\uff0c\u6211\u5076\u5c14\u4e5f\u4f1a\u53bb\u770b\u770b\u5b83\u3002\u5373\u5c06\u51fa\u56fd\uff0c\u591a\u6709\u4e0d\u820d\uff0c\u5e0c\u671b\u8fd9\u4f4d\u8001\u5bb6\u4f19\u80fd\u591f\u7ed9\u529b\u4e00\u4e9b\uff0c\u5e74\u68c0\u987a\u5229\uff0c\u4fdd\u9669\u987a\u5229\uff0c\u4f60\u82e5\u4e0d\u79bb\uff0c\u6211\u4fbf\u4e0d\u5f03\uff01</p>"},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E7%BE%8E%E5%9B%BE%E5%B1%95%E7%A4%BA/","title":"\u7f8e\u56fe\u5c55\u793a","text":""},{"location":"%E9%A6%96%E9%A1%B5/%E5%85%B3%E4%BA%8E%E9%92%92%E9%92%92/","title":"\u9492\u9492\u662f\u8c01","text":"<ul> <li>\u6d59\u6c5f\u5927\u5b66-\u7afa\u53ef\u6862\u5b66\u9662\uff08\u667a\u80fd\u8d22\u52a1\u73ed\uff092021\u7ea7\u672c\u79d1\u6bd5\u4e1a\u751f</li> <li>\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66-\u7406\u5b66\u9662\uff08\u91cf\u5316\u91d1\u878d\uff092025\u7ea7\u7855\u58eb\u65b0\u751f</li> <li>\u798f\u5efa\u4eba\uff0c\u6d59\u6c5f\u5927\u5b66\u798f\u5efa\u793e\u7fa4\u524d\u7fa4\u4e3b\uff0c\u4e24\u5c4a\u6d59\u5927\u798f\u5efa\u62db\u751f\u7ec4\u6210\u5458</li> <li> <p>\u94a2\u7434\u4e0e\u5373\u5174\u7f16\u66f2\u7231\u597d\u8005\uff0c\u53c2\u8bad\u5e72\u90e8\uff08\u66fe\u4efb\uff09\uff0c\u7814\u7a76\u52a9\u7406\uff08\u66fe\u4efb\uff09\uff0c\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66\u4ea4\u6362\u751f\uff082023\u5e74\uff09\uff0c\u4e09\u83f1\u7ffc\u795e\u8f66\u4e3b\uff0c\u80a1\u5e02\u8001\u6cb9\u6761\uff0c\u5e01\u5708\u7eaf\u65b0\u624b\u2026\u2026</p> </li> <li> <p>\u7535\u5b50\u90ae\u7bb1\uff1aYifanwu30721@gmail.com</p> </li> </ul>"},{"location":"%E9%A6%96%E9%A1%B5/%E7%BB%B4%E6%8A%A4%E5%A3%B0%E6%98%8E/","title":"\u6b22\u8fce\u6765\u5230\u9492\u9492\u7684\u8d5b\u535a\u5c0f\u5c4b\uff5e","text":"<p>\u672c\u7ad9\u4ecd\u5728\u5efa\u8bbe\u5e76\u6301\u7eed\u66f4\u65b0\u4e2d\uff0c\u5982\u6709\u4fe1\u606f\u7f3a\u5931\uff0c\u656c\u8bf7\u8c05\u89e3\u5e76\u6307\u6b63\u3002</p>"}]}