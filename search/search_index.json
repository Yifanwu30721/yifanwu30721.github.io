{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"]},"docs":[{"location":"","title":"\u6b22\u8fce\u6765\u5230\u9492\u9492\u7684\u8d5b\u535a\u5c0f\u5c4b\uff5e","text":"<p>\u672c\u7ad9\u4ecd\u5728\u5efa\u8bbe\u5e76\u6301\u7eed\u66f4\u65b0\u4e2d\uff0c\u5982\u6709\u4fe1\u606f\u7f3a\u5931\uff0c\u656c\u8bf7\u8c05\u89e3\u5e76\u6307\u6b63\u3002</p>"},{"location":"#_2","title":"\u9492\u9492\u662f\u8c01","text":"<ul> <li>\u6d59\u6c5f\u5927\u5b66-\u7afa\u53ef\u6862\u5b66\u9662\uff08\u667a\u80fd\u8d22\u52a1\u73ed\uff092021\u7ea7\u672c\u79d1\u6bd5\u4e1a\u751f</li> <li>\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66-\u7406\u5b66\u9662\uff08\u91cf\u5316\u91d1\u878d\uff092026\u7ea7\u7855\u58eb\u65b0\u751f</li> <li>\u798f\u5efa\u4eba\uff0c\u6d59\u6c5f\u5927\u5b66\u798f\u5efa\u793e\u7fa4\u524d\u7fa4\u4e3b\uff0c\u4e24\u5c4a\u6d59\u5927\u798f\u5efa\u62db\u751f\u7ec4\u6210\u5458</li> <li> <p>\u94a2\u7434\u4e0e\u5373\u5174\u7f16\u66f2\u7231\u597d\u8005\uff0c\u53c2\u8bad\u5e72\u90e8\uff08\u66fe\u4efb\uff09\uff0c\u7814\u7a76\u52a9\u7406\uff08\u66fe\u4efb\uff09\uff0c\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66\u4ea4\u6362\u751f\uff082023\u5e74\uff09\uff0c\u4e09\u83f1\u7ffc\u795e\u8f66\u4e3b\uff0c\u80a1\u5e02\u8001\u6cb9\u6761\uff0c\u5e01\u5708\u7eaf\u65b0\u624b\u2026\u2026</p> </li> <li> <p>\u7535\u5b50\u90ae\u7bb1\uff1aYifanwu30721@gmail.com</p> </li> </ul>"},{"location":"%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/","title":"\u5065\u8eab\u8bb0\u5f55","text":""},{"location":"%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/#2025726","title":"2025\u5e747\u670826\u65e5","text":"<p>\u4f53\u91cd87.1\u516c\u65a4\uff08\u9910\u524d\uff09\uff0c\u592a\u80d6\u5566\uff01</p>"},{"location":"%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/#2025812","title":"2025\u5e748\u670812\u65e5","text":"<p>\u4f53\u91cd\u964d\u5230\u4e8681.5\u516c\u65a4\uff08\u9910\u524d\uff09\uff0c\u5176\u5b9e\u6700\u8fd1\u5065\u8eab\u7684\u91cf\u4e5f\u4e0d\u591a\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u98df\u91cf\u51cf\u5c11\uff0c\u7126\u8651\u589e\u591a\u800c\u5bfc\u81f4\u7684\u3002</p>"},{"location":"%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/%E5%81%A5%E8%BA%AB%E8%AE%B0%E5%BD%95/#2025825","title":"2025\u5e748\u670825\u65e5","text":"<p>\u4f53\u91cd\u964d\u5230\u4e8680-80.5\u516c\u65a4\u4e4b\u95f4\uff0c\u771f\u662f\u8d8a\u6765\u8d8a\u7626\u4e86\u2026\u2026\u4e0d\u8fc7\u76ee\u524d\u8fd9\u4e2a\u4f53\u91cd\u5bf9\u6211\u800c\u8a00\u8fd8\u7b97\u80fd\u63a5\u53d7\uff0c\u7ee7\u7eed\u4fdd\u6301\u4e5f\u662f\u5f88\u597d\u7684\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%90%83%E5%9C%A8%E5%9D%A1%E5%B2%9B/","title":"\u5403\u5728\u5761\u5c9b","text":""},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%90%83%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_2","title":"\u4e2d\u56fd\u83dc\u7cfb","text":"<p>\u4f5c\u4e3a\u4e00\u4e2a\u534e\u4eba\u5360\u6bd470%\u4ee5\u4e0a\u7684\u56fd\u5bb6\uff0c\u65b0\u52a0\u5761\u7684\u4e2d\u56fd\u83dc\u7cfb\u76f8\u5bf9\u6b27\u7f8e\u800c\u8a00\uff0c\u81ea\u7136\u662f\u6b63\u5b97\u7684\u591a\uff0c\u751a\u81f3\u53ef\u4ee5\u8bf4\uff0c\u5728\u4e2d\u56fd\u80fd\u5403\u5230\u7684\u4e1c\u897f\uff0c\u5728\u65b0\u52a0\u5761\u4e5f\u51e0\u4e4e\u90fd\u80fd\u5403\u5230\uff0c\u6240\u4ee5\u4e2d\u56fd\u80c3\u5728\u8fd9\u91cc\u5b8c\u5168\u4e0d\u7528\u62c5\u5fc3\u5403\u4e0d\u597d\u3002\u6bd4\u8f83\u6709\u5f53\u5730\u7279\u8272\u7684\u6709\u6d77\u5357\u9e21\u996d\u3001\u4e09\u635e\u6cb3\u7c89\u7b49\uff0c\u4e3b\u8981\u662f\u6d77\u5357\u83dc\u3001\u7ca4\u83dc\u548c\u95fd\u83dc\u7684\u53d8\u79cd\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%90%83%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_3","title":"\u4e1c\u5357\u4e9a\u83dc\u7cfb","text":"<p>\u5728\u65b0\u52a0\u5761\uff0c\u6bd4\u8f83\u6709\u7279\u8272\u7684\u4e1c\u5357\u4e9a\u83dc\u4e3b\u8981\u662f\u201c\u53fb\u6c99\uff08laksa\uff09\u201d\u548c\u6930\u6d46\u996d\uff08nasi lemak\uff09\u3002\u53fb\u6c99\u6709\u70b9\u7c7b\u4f3c\u4e8e\u5927\u6742\u70e9\uff0c\u8f85\u4ee5\u5bcc\u6709\u4e1c\u5357\u4e9a\u7279\u8272\u7684\u6599\u6c41\uff0c\u53e3\u611f\u5177\u6709\u4e30\u5bcc\u7684\u5c42\u6b21\uff1b\u6930\u6d46\u996d\u987e\u540d\u601d\u4e49\uff0c\u5c31\u662f\u6930\u6d46\u548c\u7c73\u996d\u7684\u6df7\u5408\uff0c\u8fd9\u79cd\u7c73\u996d\u5403\u8d77\u6765\u4f1a\u5e26\u6709\u6930\u5b50\u7684\u751c\u5473\uff0c\u552f\u4e00\u7684\u95ee\u9898\u5c31\u5728\u4e8e\u5403\u591a\u4e86\u4f1a\u6bd4\u8f83\u817b\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%90%83%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_4","title":"\u5370\u5ea6\u83dc\u7cfb","text":"<p>\u5370\u5ea6\u88d4\u4e5f\u662f\u65b0\u52a0\u5761\u56fd\u6c11\u7684\u91cd\u8981\u7ec4\u6210\u90e8\u5206\uff0c\u56e0\u6b64\u5728\u65b0\u52a0\u5761\u4e5f\u80fd\u5403\u5230\u4e00\u4e9b\u4e0d\u9519\u7684\u5370\u5ea6\u83dc\u3002\u5370\u5ea6\u83dc\u7684\u4ee3\u8868\u4e3b\u8981\u6709\u70d9\u997c\uff08Prata\uff09\u548c\u201c\u739b\u838e\u62c9\u201d\uff0c\u65e0\u8bba\u662f\u751c\u662f\u54b8\uff0c\u53e3\u5473\u90fd\u504f\u91cd\uff0c\u800c\u4e14\u4ee5\u9ad8\u70ed\u91cf\u98df\u54c1\u4e3a\u4e3b\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%90%83%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_5","title":"\u6b27\u7f8e\u83dc\u7cfb","text":"<p>\u65b0\u52a0\u5761\u7684\u6b27\u7f8e\u83dc\u7cfb\u4e3b\u8981\u662f\u8236\u6765\u54c1\uff0c\u4f46\u4e00\u4e9b\u77e5\u540d\u53a8\u5e08\u4f1a\u5728\u8fd9\u91cc\u5f00\u5206\u5e97\uff0c\u540c\u6837\u53ef\u4ee5\u4e00\u8bd5\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%AD%A6%E5%9C%A8%E5%9D%A1%E5%B2%9B/","title":"\u5b66\u5728\u5761\u5c9b","text":""},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%AD%A6%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_2","title":"\u65b0\u52a0\u5761\u77e5\u540d\u5927\u5b66","text":"<p>\u65b0\u52a0\u5761\u7684\u5927\u5b66\u5206\u79c1\u7acb\u548c\u516c\u7acb\u4e24\u79cd\uff0c\u516c\u7acb\u5927\u5b66\u91cc\u6bd4\u8f83\u77e5\u540d\u7684\u6709\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66(NUS)\u3001\u5357\u6d0b\u7406\u5de5\u5927\u5b66(NTU)\uff0c\u8fd9\u4e24\u6240\u7684\u4e16\u754c\u6392\u540d\u4e00\u76f4\u8f83\u4e3a\u9760\u524d\uff0c\u88ab\u79f0\u4e3a\u4f20\u7edf\u610f\u4e49\u4e0a\u7684\u201c\u65b0\u4e8c\u201d\uff0c\u53e6\u4e00\u6240\u77e5\u540d\u7684\u516c\u7acb\u5927\u5b66\u662f\u65b0\u52a0\u5761\u7ba1\u7406\u5927\u5b66(SMU)\uff0c\u8fd9\u6240\u5927\u5b66\u867d\u7136\u7efc\u5408\u6392\u540d\u4e0d\u51fa\u5f69\uff0c\u4f46\u5728\u5546\u79d1\u9886\u57df\u4e5f\u5c5e\u4e8e\u4e16\u754c\u4e00\u6d41\uff0c\u5728\u7559\u5761\u5c31\u4e1a\u7684\u96be\u5ea6\u4e0a\uff0c\u65b0\u7ba1\u7406\u4e0e\u201c\u65b0\u4e8c\u201d\u76f8\u6bd4\uff0c\u751a\u81f3\u66f4\u5360\u4f18\u52bf\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%AD%A6%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_3","title":"\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66","text":"<p>\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66\uff08\u7b80\u79f0\u201c\u56fd\u5927\u201d\uff09\u662f\u6211\u672c\u79d1\u4ea4\u6362\u548c\u7855\u58eb\u5c31\u8bfb\u7684\u5b66\u6821\u3002\u5176\u4e3b\u6821\u533a\u4f4d\u4e8e\u897f\u6d77\u5cb8\u7684\u80af\u7279\u5c97\uff08Kent Ridge\uff09\u9644\u8fd1\uff0c\u5360\u5730\u9762\u79ef\u5e76\u4e0d\u6bd4\u6d59\u6c5f\u5927\u5b66\u7684\u7d2b\u91d1\u6e2f\u6821\u533a\u5c0f\u591a\u5c11\u3002\u4ece\u8f6f\u786c\u4ef6\u8bbe\u65bd\u6765\u770b\uff0c\u65b0\u52a0\u5761\u653f\u5e9c\u662f\u5f88\u820d\u5f97\u6295\u5165\u7684\uff0c\u56fd\u5927\u5e08\u751f\u80fd\u591f\u63a5\u89e6\u5230\u7684\u6bcf\u4e00\u95f4\u6559\u5ba4\uff0c\u548c\u6bcf\u4e00\u9879\u670d\u52a1\uff0c\u90fd\u6ca1\u6709\u5f88\u660e\u663e\u7684\u95ee\u9898\uff08\u6559\u5ba4\u91cc\u751a\u81f3\u5b89\u88c5\u4e86Bose\u7684\u97f3\u54cd\u7cfb\u7edf\uff0c\u4ee5\u53ca\u5b66\u6821\u4e00\u4e2a\u6708\u7684\u7a7a\u8c03\u8d39\u7528\u5c31\u903e\u4eba\u6c11\u5e01\u767e\u4e07\u5143\uff09\uff0c\u5728\u6821\u4efb\u804c\u7684\u8001\u5e08\uff0c\u4e5f\u57fa\u672c\u662f\u4e1a\u754c\u7684\u5927\u725b\uff0c\u5927\u591a\u5177\u6709\u6b27\u7f8e\u9876\u7ea7\u540d\u6821\u7684\u535a\u58eb\u5b66\u4f4d\u3002\u6b64\u5916\uff0c\u56fd\u5927\u8fd8\u6709\u4f4d\u4e8e\u6b66\u5409\u77e5\u9a6c\uff08Bukit Timah\uff09\u548c\u6b27\u5357\u56ed\uff08Outram Park\uff09\u7684\u4e24\u4e2a\u6821\u533a\uff0c\u4e0d\u8fc7\u8fd9\u4e24\u4e2a\u6821\u533a\u4e3b\u8981\u4f9b\u6cd5\u5b66\u9662\u7b49\u7279\u5b9a\u4e13\u4e1a\u7684\u5b66\u751f\u4f7f\u7528\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%AD%A6%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_4","title":"\u5357\u6d0b\u7406\u5de5\u5927\u5b66","text":"<p>\u5357\u6d0b\u7406\u5de5\u5927\u5b66\uff08\u7b80\u79f0\u201c\u5357\u5927\u201d\uff09\u7684\u5efa\u8bbe\uff0c\u4e0e\u798f\u5efa\u4eba\u6709\u7740\u5343\u4e1d\u4e07\u7f15\u7684\u8054\u7cfb\u3002\u5728\u5357\u6d0b\u7406\u5de5\u7684\u6559\u5b66\u697c\u91cc\uff0c\u751a\u81f3\u80fd\u770b\u5230\u611f\u8c22\u798f\u5efa\u540c\u80de\u5efa\u6821\u7684\u534e\u6587\u94ed\u6587\u3002\u4e0e\u56fd\u5927\u76f8\u6bd4\uff0c\u5357\u5927\u7684\u4f4d\u7f6e\u76f8\u5bf9\u504f\u50fb\uff0c\u4f4d\u4e8e\u65b0\u52a0\u5761\u7684\u897f\u90e8\u3002\u8fd9\u5e26\u6765\u7684\u4e00\u4e2a\u4f18\u70b9\u662f\u623f\u79df\u4e0e\u5bbf\u820d\u79df\u91d1\u76f8\u5bf9\u4fbf\u5b9c\uff0c\u636e\u8bf4\u79df\u8d41\u540c\u7b49\u6c34\u5e73\u7684\u516c\u5bd3\uff0c\u5357\u5927\u9644\u8fd1\u8981\u6bd4\u56fd\u5927\u9644\u8fd1\u4fbf\u5b9c\u5c06\u8fd1\u56db\u5206\u4e4b\u4e00\u3002</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E5%AD%A6%E5%9C%A8%E5%9D%A1%E5%B2%9B/#_5","title":"\u65b0\u52a0\u5761\u7ba1\u7406\u5927\u5b66","text":"<p>\u65b0\u52a0\u5761\u7ba1\u7406\u5927\u5b66\u4f4d\u4e8e\u798f\u5eb7\u5b81\u516c\u56ed\u4e00\u5e26\uff0c\u662f\u4e09\u6240\u5927\u5b66\u4e2d\u6700\u5c0f\uff0c\u4f46\u6700\u4e2d\u5fc3\u7684\u4e00\u6240\u3002\u5c0f\u5230\u6ca1\u6709\u5bbf\u820d\uff08</p>"},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E8%BD%AE%E4%B8%8A%E5%9D%A1%E5%B2%9B/","title":"\u8f6e\u4e0a\u5761\u5c9b","text":""},{"location":"%E5%9D%A1%E5%B2%9B%E7%94%9F%E6%B4%BB/%E8%BD%AE%E4%B8%8A%E5%9D%A1%E5%B2%9B/#_2","title":"\u65b0\u52a0\u5761\u7684\u8d2d\u8f66\u5236\u5ea6","text":"<p>\u5728\u65b0\u52a0\u5761\uff0c\u65e0\u8bba\u8f66\u578b\u5982\u4f55\uff0c\u53ea\u8981\u80fd\u8d1f\u62c5\u4e00\u8f86\u8f66\uff0c\u4e00\u5b9a\u662f\u5bb6\u5883\u76f8\u5bf9\u6bb7\u5b9e\u7684\u3002\u65b0\u52a0\u5761\u7684\u8f66\u4ef7\u53ef\u4ee5\u5206\u4e3a\u4e24\u90e8\u5206\uff1a1.\u62e5\u8f66\u8bc1(COE)\uff0c\u65b0\u52a0\u5761\u653f\u5e9c\u4e3a\u4e86\u9650\u5236\u79c1\u5bb6\u8f66\u6570\u91cf\uff0c\u8981\u6c42\u4e70\u8f66\u65f6\u5fc5\u987b\u9644\u5e26COE\uff0c\u76ee\u524d\u4e00\u5f20COE\u7684\u4ef7\u683c\u5927\u6982\u572810\u4e07\u65b0\u5e01\u5de6\u53f3\uff1b2.\u88f8\u8f66\u4ef7\uff0c\u65b0\u52a0\u5761\u6ca1\u6709\u81ea\u5df1\u7684\u6c7d\u8f66\u5de5\u5382\uff0c\u6240\u6709\u7684\u6c7d\u8f66\u5747\u4ece\u56fd\u5916\u8fdb\u53e3\uff0c\u52a0\u4e4b\u653f\u5e9c\u7684\u9ad8\u989d\u5173\u7a0e\uff0c\u88f8\u8f66\u4ef7\u540c\u6837\u6bd4\u4e2d\u56fd\u5185\u5730\u8d35\u51fa\u5f88\u591a\u3002\u5728\u8fd9\u6837\u7684\u5236\u5ea6\u4e4b\u4e0b\uff0c\u4e00\u8f86\u666e\u901a\u4e30\u7530\u5361\u7f57\u62c9\uff08\u5728\u65b0\u52a0\u5761\u79f0\u4f5cALTIS\uff09\u7684\u603b\u4ef7\uff0c\u53ef\u4ee5\u8fbe\u5230\u7ea615\u4e07\u65b0\u5e01\uff08\u8d85\u8fc7\u4eba\u6c11\u5e0180\u4e07\u5143\uff09\uff0c\u8fd9\u4e5f\u662f\u5927\u90e8\u5206\u65b0\u52a0\u5761\u4eba\u4e0d\u4e70\u8f66\u7684\u91cd\u8981\u539f\u56e0\u3002</p>"},{"location":"%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/","title":"\u9492\u9492\u7684\u60c5\u611f\u65e5\u8bb0","text":""},{"location":"%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/#2025812","title":"2025\u5e748\u670812\u65e5","text":"<p>\u8fd9\u4e9b\u5929\u5728\u65b0\u52a0\u5761\uff0c\u5176\u5b9e\u9047\u5230\u4e86\u5f88\u591a\u4e0d\u987a\u5fc3\u7684\u4e8b\u60c5\uff1a\u9009\u8bfe\u53d7\u963b\uff1b\u5b66\u751f\u7b7e\uff08STP\uff09\u8fdf\u8fdf\u4e0d\u4e0b\uff1b\u975e\u5e38\u5f3a\u70c8\u7684\u601d\u5bb6\u60c5\u7eea\u2026\u2026\u5176\u5b9e\u65b0\u52a0\u5761\u79bb\u5bb6\u5e76\u4e0d\u8fdc\uff08\u751a\u81f3\u8fd8\u7565\u8fd1\u4e8e\u6211\u56fd\u7684\u65b0\u7586\uff09\uff0c\u6211\u4e4b\u524d\u4e5f\u5728\u6b64\u4ea4\u6362\u8fc7\u5c0f\u534a\u5e74\uff0c\u4f46\u8fd9\u6b21\u590d\u6742\u7684\u60c5\u7eea\u7ed9\u6211\u5e26\u6765\u4e86\u8bf8\u591a\u714e\u71ac\uff1a\u6bcf\u5929\u65e9\u4e0a\u9192\u6765\uff0c\u5c31\u9677\u5165\u5f3a\u70c8\u7684\u7126\u8651\u548c\u60f3\u5bb6\u4e4b\u4e2d\uff1b\u4f46\u6bcf\u5929\u665a\u4e0a\uff0c\u505a\u5b8c\u6bcf\u65e5\u7684\u7410\u4e8b\uff0c\u9759\u9759\u5446\u5728\u623f\u95f4\u91cc\u7684\u65f6\u5019\uff0c\u5374\u53c8\u89c9\u5f97\u73b0\u5728\u7684\u81ea\u5df1\u662f\u4f55\u7b49\u5e78\u8fd0\u3002</p> <p>\u6211\u7684\u540c\u5b66\u90fd\u662f\u5f88\u4f18\u79c0\u7684\u4eba\uff0c\u548c\u6211\u4e00\u6837\uff0c\u6bd5\u4e1a\u4e8eZJU\u6216\u8005\u5176\u4ed6\u66f4\u597d\u7684\u540d\u6821\uff0c\u6709\u4e00\u4e9b\u5728\u4f20\u7edf\u91d1\u878d/\u91cf\u5316\u5b9e\u76d8\u65b9\u9762\u5df2\u7ecf\u5c0f\u6709\u6210\u5c31\uff0c\u548c\u4ed6\u4eec\u5728\u4e00\u8d77\u786e\u5b9e\u8ba9\u6211\u7684\u773c\u754c\u6709\u4e86\u8d28\u7684\u63d0\u5347\u3002\u65b0\u52a0\u5761\u5176\u5b9e\u4e5f\u662f\u4e00\u4e2a\u5f88\u597d\u7684\u56fd\u5bb6\uff0c\u81f3\u5c11\u6765\u8bf4\uff0c\u5e72\u51c0\u3001\u4e25\u8c28\u3001\u9ad8\u7d20\u8d28\u3002NUS\u7684\u5b66\u98ce\u4e5f\u76f8\u5bf9\u7075\u6d3b\u3001\u81ea\u7531\u4e00\u4e9b\uff08\u5982\u679c\u771f\u7684\u6709\u4e8b\uff0c\u6ca1\u6cd5\u6765\u542c\u8bfe\uff0c\u53ef\u4ee5\u6362\u65f6\u95f4\u6bb5\u6216\u8005\u770b\u56de\u653e\uff09\u2026\u2026\u5bf9\u4e8e\u8fd9\u4e9b\uff0c\u6211\u4e0d\u5426\u8ba4\uff0c\u4e14\u5f3a\u70c8\u80af\u5b9a\uff0c\u8fd9\u4e5f\u662f\u6211\u665a\u4e0a\u8ba4\u4e3a\u201c\u6211\u5f88\u5e78\u798f\u201d\u7684\u91cd\u8981\u539f\u56e0\uff1b</p> <p>\u4f46\u662f\uff0c\u60f3\u5bb6\uff0c\u5f88\u5f3a\u70c8\u7684\u60f3\u5bb6\uff0c\u5728\u67d0\u4e9b\u65f6\u523b\uff0c\u65b0\u52a0\u5761\u7684\u4e00\u5207\u4f18\u70b9\uff0c\u90fd\u80fd\u88ab\u8fd9\u4e2a\u8bcd\u4e00\u4e3e\u51fb\u788e\uff0c\u8fd9\u662f\u6211\u5728\u56fd\u5185\u4efb\u4f55\u5730\u65b9\u90fd\u65e0\u6cd5\u611f\u53d7\u5230\u7684\u3002\uff08\u540e\u7eed\u518d\u5199\u5427\uff0c\u60f3\u5bb6\u7684\u60c5\u7eea\u7206\u53d1\u4e86\uff0c\u60f3\u4f11\u606f\u4e00\u4f1a\uff09</p>"},{"location":"%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/%E6%83%85%E6%84%9F%E6%97%A5%E8%AE%B0/#2025828","title":"2025\u5e748\u670828\u65e5","text":"<p>\u8f6c\u773c\u534a\u4e2a\u6708\u8fc7\u53bb\u4e86\uff0c\u60f3\u5bb6\u7684\u60c5\u7eea\u4e5f\u6e10\u6e10\u88ab\u66f4\u91cd\u8981\u7684\u4e8b\u60c5\u6240\u53d6\u4ee3\u3002\u548c\u4e2d\u56fd\u5185\u5730\u4e0d\u540c\uff0c\u73b0\u5728\u5df2\u7ecf\u662f\u5f00\u5b66\u7684\u7b2c\u4e09\u5468\u4e86\uff08\u53ef\u4ee5\u8bf4\uff0c\u8fd9\u5b66\u671f\u7684\u8bfe\u4e1a\u5df2\u7ecf\u5b8c\u6210\u4e86\u5c06\u8fd1\u56db\u5206\u4e4b\u4e00\uff09\uff0c\u65f6\u95f4\u8fc7\u7684\u771f\u5f97\u5f88\u5feb\uff0c\u73b0\u5728\u4e3b\u8981\u7684\u62c5\u5fc3\u5728\u4e8e\uff0c\u81ea\u5df1\u80fd\u4e0d\u80fd\u628a\u8fd9\u4e9b\u77e5\u8bc6\u5b66\u4ee5\u81f4\u7528\u3002</p> <p>\u6211\u7684\u4e13\u4e1a\u8bfe\u7a0b\uff0c\u4e2a\u4eba\u8ba4\u4e3a\u5bf9\u6709\u5fd7\u4e8e\u91cf\u5316\u6295\u8d44\uff0c\u4e43\u81f3\u4f20\u7edf\u91d1\u878d\u6295\u8d44\u7684\u4eba\u800c\u8a00\uff0c\u90fd\u662f\u5341\u5206\u6709\u7528\u7684\u3002\u672c\u79d1\u671f\u95f4\u53ef\u80fd\u4e00\u7b14\u5e26\u8fc7\u7684\u968f\u673a\u8fc7\u7a0b\uff08\u5c24\u5176\u662f\u5e03\u6717\u8fd0\u52a8\uff09\uff0c\u5728\u7855\u58eb\u9636\u6bb5\u4f1a\u6709\u4e24\u95e8\u4ee5\u4e0a\u7684\u76f8\u5173\u8bfe\u7a0b\uff0c\u4ece\u4e25\u8c28\u7684\u6570\u5b66\u89d2\u5ea6\u51fa\u53d1\uff0c\u63b0\u5f00\u4e86\u7ec6\u7ec6\u8bb2\u89e3\u3002\u5728\u6b64\u4e4b\u524d\uff0c\u5bf9\u91cf\u5316\u7684\u7406\u89e3\u53ef\u80fd\u4ec5\u4ec5\u5c40\u9650\u4e8e\u201c\u7b56\u7565\u2014\u2014\u56de\u6d4b\u2014\u2014\u5b9e\u76d8\u201d\u8fd9\u4e00\u4e2a\u7b80\u5355\u7684\u8fc7\u7a0b\uff0c\u4f46\u73b0\u5728\u53ef\u80fd\u4f1a\u66f4\u52a0\u5228\u6839\u95ee\u5e95\uff0c\u591a\u95ee\u95ee\u81ea\u5df1\uff1a\u6211\u4e3a\u4ec0\u4e48\u8981\u505a\u8fd9\u4e2a\u7b56\u7565\uff1f\u4ece\u6570\u7406\u4e0a\u770b\uff0c\u8fd9\u4e9b\u7b56\u7565\u662f\u4e0d\u662f\u771f\u7684\u80fd\u7528\uff1f\u53e6\u5916\uff0c\u5728\u6b64\u4e4b\u524d\uff0c\u53ef\u80fd\u66f4\u591a\u5173\u6ce8\u7684\u662f\u786e\u5b9a\u6027\u6536\u76ca\uff0c\u5bf9\u968f\u673a\u8fc7\u7a0b\u7684\u5b66\u4e60\u4e5f\u4f7f\u6211\u66f4\u591a\u5173\u6ce8\u5230\u968f\u673a\u90e8\u5206\uff08\u6bd4\u5982White Noise\uff09\u7684\u5f71\u54cd\uff0c\u4e5f\u8bb8\u80fd\u591f\u8fdb\u4e00\u6b65\u589e\u5f3a\u7b56\u7565\u7684\u51c6\u786e\u6027\u3002</p> <p>\u5728\u5b66\u4e60\u4e4b\u4f59\uff0c\u6211\u4e5f\u5728\u5173\u6ce8\u4e00\u4e9b\u804c\u4e1a\u53d1\u5c55\u548c\u751f\u6daf\u89c4\u5212\u76f8\u5173\u7684\u4fe1\u606f\uff08\u6bd4\u5982\uff0c\u5927\u5b66\u751f\u5c31\u4e1a\u8d8b\u52bf\u3001\u5404\u56fd\u5404\u884c\u4e1a\u7684\u5c31\u4e1a\u60c5\u51b5\uff0c\u7b49\u7b49\uff09\u3002\u5ba2\u89c2\u6765\u770b\uff0c\u73b0\u5728\u7684\u5c31\u4e1a\u5f62\u52bf\uff0c\u76f8\u6bd410\u5e74\u524d\u621620\u5e74\u524d\uff0c\u662f\u5904\u4e8e\u4f4e\u8c37\u671f\u7684\uff0c\u8bb8\u591a\u540c\u5b66\u9009\u62e9\u8bfb\u7855\u8bfb\u535a\uff0c\u4e5f\u5e76\u975e\u5b8c\u5168\u662f\u57fa\u4e8e\u5b66\u672f\u5174\u8da3\uff0c\u800c\u662f\u67d0\u79cd\u610f\u4e49\u4e0a\u7684\u5b66\u5386\u5bc4\u5b58\u3002\u603b\u800c\u8a00\u4e4b\uff0c\u8fd8\u662f\u5f88\u5e86\u5e78\u81ea\u5df1\u80fd\u591f\u9009\u62e9\u8fd9\u6240\u5b66\u6821\uff0c\u8fd9\u4e2a\u4e13\u4e1a\uff0c\u867d\u7136\u67d0\u4e9b\u8bfe\u7a0b\u5f88\u6570\u7406\u5f88\u96be\uff0c\u4f46\u6211\u76f8\u4fe1\uff0c\u8ba4\u771f\u94bb\u7814\u7684\u8bdd\uff0c\u6210\u7ee9\u5012\u662f\u4e0d\u81f3\u4e8e\u592a\u5dee\u7684\uff0c\u800c\u4e14\u6536\u83b7\u7684\u5e7f\u5ea6\u4e5f\u4e00\u5b9a\u8fdc\u9ad8\u4e8e\u7ee7\u7eed\u5c31\u8bfb\u4f1a\u8ba1\u4e13\u4e1a\u3002\u7ee7\u7eed\u52a0\u6cb9\uff5e\uff01</p>"},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/","title":"\u6211\u4e0e\u7ffc\u795e","text":""},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/#_2","title":"\u4e3a\u4ec0\u4e48\u4e70\u7ffc\u795e","text":"<p>2024\u5e7412\u6708\uff0c\u548c\u670b\u53cb\u4e00\u8d77\u53bb\u901b\u4e8c\u624b\u8f66\u5e02\u573a\uff0c\u672c\u6765\u60f3\u8981\u770b\u4e00\u8f86\u4fbf\u5b9c\u7684\u798f\u7279\u5609\u5e74\u534e\uff0c\u4f46\u540e\u6765\u53d1\u73b0\u7f51\u4e0a\u7684\u4ef7\u683c\u7eaf\u5f15\u6d41\uff0c\u5b9e\u9645\u4ef7\u683c\u8d35\u5f97\u591a\u3002\u4e34\u8d70\u65f6\uff0c\u6b63\u5de7\u770b\u5230\u4e86\u8fd9\u8f86\u4fdd\u517b\u7684\u5f88\u597d\u7684\u4e09\u83f1\u7ffc\u795e\uff0c\u4ef7\u683c\u4e5f\u5408\u9002\uff0c\u9042\u679c\u65ad\u4e70\u4e0b\uff08\u8be6\u60c5\u8bf7\u770bcc98: https://www.cc98.org/topic/6062784\uff0c\u9700\u6d59\u5927VPN\u767b\u5f55\uff09</p>"},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/#_3","title":"\u6211\u548c\u7ffc\u795e\u7684\u6545\u4e8b","text":"<p>\u81f3\u4eca\uff082025\u5e747\u6708\uff09\uff0c\u6211\u5df2\u7ecf\u5f00\u7740\u5b83\u8d70\u8fc7\u4e864000\u4f59\u516c\u91cc\uff0c\u5728\u676d\u5dde\u5e02\u5185\u7ecf\u5386\u4e86\u7d2b\u91d1\u6e2f-\u7389\u6cc9\u7684\u65e0\u6570\u6b21\u901a\u52e4\uff0c\u6d59\u5927\u7684\u4e03\u4e2a\u6821\u533a\uff0c\u9664\u4e86\u4e4b\u6c5f\u6821\u533a\u5916\uff0c\u6211\u90fd\u5f00\u7740\u5b83\u53bb\u8fc7\u3002\u5728\u676d\u5dde\u5e02\u5916\uff0c\u6211\u4eec\u53bb\u4e86\u6d77\u5b81\u3001\u821f\u5c71\uff0c\u4ee5\u53ca\u6bd5\u4e1a\u540e\u5343\u91cc\u8fe2\u8fe2\u5954\u56de\u798f\u5efa\u3002\u5b83\u603b\u662f\u6709\u4e00\u4e9b\u5c0f\u6bdb\u75c5\uff0c\u6bd4\u5982\u8f66\u7a97\u964d\u4e0d\u4e0b\u6765\uff0c\u5929\u7a97\u6f0f\u6c34\u7b49\u7b49\uff0c\u4f46\u6211\u6b23\u6170\u7684\u662f\uff0c\u5b83\u4ece\u6ca1\u6709\u628a\u6211\u6482\u5728\u8def\u4e0a\uff0c\u5f88\u5fe0\u5b9e\uff0c\u5f88\u53ef\u9760\u3002 \u73b0\u5728\uff0c\u5b83\u9759\u9759\u8eba\u5728\u6211\u5bb6\u5c0f\u533a\u7684\u4e00\u9685\uff0c\u6211\u5076\u5c14\u4e5f\u4f1a\u53bb\u770b\u770b\u5b83\u3002\u5373\u5c06\u51fa\u56fd\uff0c\u591a\u6709\u4e0d\u820d\uff0c\u5e0c\u671b\u8fd9\u4f4d\u8001\u5bb6\u4f19\u80fd\u591f\u7ed9\u529b\u4e00\u4e9b\uff0c\u5e74\u68c0\u987a\u5229\uff0c\u4fdd\u9669\u987a\u5229\uff0c\u4f60\u82e5\u4e0d\u79bb\uff0c\u6211\u4fbf\u4e0d\u5f03\uff01</p>"},{"location":"%E6%88%91%E4%B8%8E%E7%BF%BC%E7%A5%9E/%E7%BE%8E%E5%9B%BE%E5%B1%95%E7%A4%BA/","title":"\u7f8e\u56fe\u5c55\u793a","text":""},{"location":"%E9%A6%96%E9%A1%B5/%E5%85%B3%E4%BA%8E%E9%92%92%E9%92%92/","title":"\u5173\u4e8e\u9492\u9492","text":""},{"location":"%E9%A6%96%E9%A1%B5/%E5%85%B3%E4%BA%8E%E9%92%92%E9%92%92/#_2","title":"\u9492\u9492\u662f\u8c01","text":"<ul> <li>\u6d59\u6c5f\u5927\u5b66-\u7afa\u53ef\u6862\u5b66\u9662\uff08\u667a\u80fd\u8d22\u52a1\u73ed\uff092021\u7ea7\u672c\u79d1\u6bd5\u4e1a\u751f</li> <li>\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66-\u7406\u5b66\u9662\uff08\u91cf\u5316\u91d1\u878d\uff092025\u7ea7\u7855\u58eb\u65b0\u751f\uff0c\u5b66\u751f\u5927\u4f7f\uff08FPSA\uff09</li> <li>\u798f\u5efa\u4eba\uff0c\u6d59\u6c5f\u5927\u5b66\u798f\u5efa\u793e\u7fa4\u524d\u7fa4\u4e3b\uff0c\u4e24\u5c4a\u6d59\u5927\u798f\u5efa\u62db\u751f\u7ec4\u6210\u5458</li> <li>\u94a2\u7434\u4e0e\u5373\u5174\u7f16\u66f2\u7231\u597d\u8005\uff0c\u53c2\u8bad\u5e72\u90e8\uff08\u66fe\u4efb\uff09\uff0c\u7814\u7a76\u52a9\u7406\uff08\u66fe\u4efb\uff09\uff0c\u65b0\u52a0\u5761\u56fd\u7acb\u5927\u5b66\u4ea4\u6362\u751f\uff082023\u5e74\uff09\uff0c\u4e09\u83f1\u7ffc\u795e\u8f66\u4e3b\uff0c\u80a1\u5e02\u8001\u6cb9\u6761\uff0c\u5e01\u5708\u7eaf\u65b0\u624b\u2026\u2026</li> </ul>"},{"location":"%E9%A6%96%E9%A1%B5/%E5%85%B3%E4%BA%8E%E9%92%92%E9%92%92/#_3","title":"\u4eba\u751f\u683c\u8a00","text":"<ul> <li>\u505a\u597d\u624b\u5934\u7684\u4e8b\uff0c\u65f6\u95f4\u4f1a\u6307\u5f15\u4e00\u5207\u3002</li> </ul>"},{"location":"%E9%A6%96%E9%A1%B5/%E5%85%B3%E4%BA%8E%E9%92%92%E9%92%92/#_4","title":"\u5176\u4ed6\u7f51\u5740","text":"<ul> <li>\u7535\u5b50\u90ae\u7bb1\uff1aYifanwu30721@gmail.com</li> <li>\u9886\u82f1\uff1ahttps://www.linkedin.com/in/yifan-wu-074194378/</li> </ul>"},{"location":"%E9%A6%96%E9%A1%B5/%E7%BB%B4%E6%8A%A4%E5%A3%B0%E6%98%8E/","title":"\u6b22\u8fce\u6765\u5230\u9492\u9492\u7684\u8d5b\u535a\u5c0f\u5c4b\uff5e","text":"<p>\u672c\u7ad9\u4ecd\u5728\u5efa\u8bbe\u5e76\u6301\u7eed\u66f4\u65b0\u4e2d\uff0c\u5982\u6709\u4fe1\u606f\u7f3a\u5931\uff0c\u656c\u8bf7\u8c05\u89e3\u5e76\u6307\u6b63\u3002</p>"}]}